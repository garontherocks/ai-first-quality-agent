{
  "name": "ai-first-quality-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "playwright test",
    "agent:demo": "node --import tsx src/agent/cli.ts fixtures/changes/incident-priority.json",
    "eval": "node --import tsx src/evals/cli.ts fixtures/evals/quality-plans.json"
  },
  "dependencies": {
    "express": "5.1.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
