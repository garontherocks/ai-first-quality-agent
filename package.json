{
  "name": "ai-first-quality-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "playwright test",
    "agent:demo": "node --import tsx src/agent/cli.ts fixtures/changes/incident-priority.json",
    "eval": "node --import tsx src/evals/cli.ts fixtures/evals/quality-plans.json",
    "eval:adversarial": "node --import tsx src/evals/adversarial-cli.ts fixtures/evals/adversarial.json reports/adversarial-evals.json",
    "evidence:verify": "node --import tsx src/evidence/cli.ts evidence/v1/contract.json reports/adversarial-evals.json",
    "mcp:start": "node --import tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
